# Copia este archivo a .env y sustituye los valores de ejemplo antes de usarlo.
DB_NAME=serenity_db
DB_USER=serenity_test_user
DB_PASSWORD=REPLACE_WITH_A_TEST_DATABASE_PASSWORD

# Falso: reemplazar antes de ejecutar. HS256 requiere al menos 32 bytes.
# Sugerencia: openssl rand -base64 48
JWT_SECRET=FAKE_REPLACE_THIS_SECRET_WITH_A_RANDOM_VALUE_LONGER_THAN_32_BYTES_1234567890
JWT_EXPIRATION=86400000

# Configuración HTTP / seguridad
PORT=8081
# En el servidor de pruebas, usa el origen desde el que se abre el frontend (p. ej. http://IP_DEL_SERVIDOR).
# Se admiten varios orígenes separados por coma, por ejemplo http://host1,http://host2.
CORS_ORIGINS=http://localhost:4200
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# Correo y servicios opcionales
EMAIL_ENABLED=false
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
FRASES_API_URL=https://cdn.jsdelivr.net/gh/GomezMig03/MotivationalAPI
REMINDERS_ZONE=America/Bogota

# Umbral de moderación
REPORTES_PROCEDENTES_RESTRICCION=3

# Appender asíncrono de logs en PostgreSQL
APP_LOGGING_DATABASE_ENABLED=true
APP_LOGGING_DATABASE_MINIMUM_LEVEL=WARN
APP_LOGGING_DATABASE_BATCH_SIZE=100
APP_LOGGING_DATABASE_FLUSH_INTERVAL_MS=2000
APP_LOGGING_DATABASE_QUEUE_CAPACITY=10000
APP_LOGGING_DATABASE_MAX_MESSAGE_LENGTH=10000
APP_LOGGING_DATABASE_MAX_STACK_TRACE_LENGTH=50000
APP_LOGGING_DATABASE_MAX_RETRIES=3
APP_LOGGING_DATABASE_SHUTDOWN_WAIT_MS=5000
APP_LOGGING_DATABASE_CLEANUP_ENABLED=false
APP_LOGGING_DATABASE_CLEANUP_RETENTION_DAYS=30

# Perfil y tuning del perfil test para carga
SPRING_PROFILES_ACTIVE=test
DB_POOL_MAX_SIZE=30
DB_POOL_MIN_IDLE=10
DB_POOL_CONNECTION_TIMEOUT_MS=30000
TOMCAT_THREADS_MAX=200
TOMCAT_ACCEPT_COUNT=100
